+
+import {PrefService} from '/shared/settings/prefs2/pref_service.js';
+import {PrefServiceObserverMixin} from '/shared/settings/prefs2/pref_service_observer_mixin.js';
+import {HelpBubbleMixin} from 'chrome://resources/cr_components/help_bubble/help_bubble_mixin.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {I18nMixin} from 'chrome://resources/cr_elements/i18n_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import type {HarkServicesChangeHandler} from './changelog_proxy.js';
+import {HarkServicesChangeHandlerImpl} from './changelog_proxy.js';
+import {getTemplate} from './services_page.html.js';
+
+const SettingsHarkServicesPageElementBase =
+    HelpBubbleMixin(I18nMixin(PrefServiceObserverMixin(PolymerElement)));
+
+export class SettingsHarkServicesPageElement extends
+    SettingsHarkServicesPageElementBase {
+  private changeProxy_: HarkServicesChangeHandler =
+      HarkServicesChangeHandlerImpl.getInstance();
+
+  static get is() {
+    return 'settings-hark-services-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      ignoreChecked_: Boolean,
+      changes_: Array,
+      originOverridePref_: Object,
+      servicesEnabledPref_: Object,
+    };
+  }
+
+  declare private changes_: string[];
+  declare private ignoreChecked_: boolean;
+  declare private originOverridePref_:
+      chrome.settingsPrivate.PrefObject<string>|undefined;
+  declare private servicesEnabledPref_:
+      chrome.settingsPrivate.PrefObject<boolean>|undefined;
+
+  override connectedCallback() {
+    super.connectedCallback();
+
+    this.mirrorPrefs({
+      'hark.services.enabled': 'servicesEnabledPref_',
+      'hark.services.origin_override': 'originOverridePref_',
+    });
+  }
+
+  private toOrigin(thing: string) {
+    try {
+      return new URL(thing).origin;
+    } catch {
+      return null;
+    }
+  }
+
+  private updateChangelogState(changes: string[]) {
+    this.changes_ = changes.flatMap(ch => ch.split('\n'));
+  }
+
+  private requestChangelog() {
+    this.changeProxy_.requestChangelog().then(
+        this.updateChangelogState.bind(this));
+  }
+
+  private onAcknowledgedChangelog_() {
+    this.changeProxy_.acknowledgeChanges(this.ignoreChecked_);
+    this.requestChangelog();
+  }
+
+  override ready() {
+    super.ready();
+    this.requestChangelog();
+  }
+
+  protected onOriginOverrideKeydown_(event: KeyboardEvent) {
+    const target = event.target as CrInputElement;
+
+    if (event.key === 'Escape' || event.key === 'Enter') {
+      target.blur();
+    }
+  }
+
+  private onOriginOverrideChange_(event: Event) {
+    const target = event.target as CrInputElement;
+    if (target.invalid) {
+      return;
+    }
+
+    const origin = this.toOrigin(target.value);
+    if (origin) {
+      target.value = origin;
+    }
+
+    PrefService.getInstance().setPrefValue(
+        'hark.services.origin_override', target.value);
+  }
+}
+
+declare global {
+    interface HTMLElementTagNameMap {
+      'settings-hark-services-page': SettingsHarkServicesPageElement;
+    }
+}
+
+customElements.define(SettingsHarkServicesPageElement.is, SettingsHarkServicesPageElement);
